{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native/${presetName}"
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "targets": [
        "sharpcpp-rbfx-native"
      ]
    },
    {
      "name": "Release",
      "configurePreset": "dev",
      "configuration": "Release",
      "targets": [
        "sharpcpp-rbfx-native"
      ]
    }
  ]
}
