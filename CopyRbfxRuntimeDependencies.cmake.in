# CMP0207 NEW normalizes paths before the filter regexes in file(GET_RUNTIME_DEPENDENCIES). Paths use "/" as separator.
if(POLICY CMP0207)
  cmake_policy(SET CMP0207 NEW)
endif()

set(sdk_root "@RBFX_ENGINE_ROOT@")

# The files go next to the target by default. The install rules set destination_dir to copy them to the install prefix.
if(NOT DEFINED destination_dir OR destination_dir STREQUAL "")
  set(destination_dir "${output_dir}")
endif()

# The caller passes native paths. The prefix tests below need the CMake path form.
foreach(path_variable IN ITEMS target_file output_dir destination_dir urho_dir urho_library_file)
  cmake_path(SET ${path_variable} "${${path_variable}}")
endforeach()

set(search_directories
  "${urho_dir}"
  "${sdk_root}/bin/${config}"
  "${sdk_root}/lib/${config}")

function(resolve_sdk_runtime_source runtime_dependency resolved_source_var)
  set(runtime_dependency_source "${runtime_dependency}")

  string(FIND "${runtime_dependency_source}" "${output_dir}/" output_dependency_prefix)
  if(output_dependency_prefix EQUAL 0)
    get_filename_component(runtime_dependency_name "${runtime_dependency_source}" NAME)

    foreach(search_directory IN LISTS search_directories)
      if(EXISTS "${search_directory}/${runtime_dependency_name}")
        set(runtime_dependency_source "${search_directory}/${runtime_dependency_name}")
        break()
      endif()
    endforeach()
  endif()

  string(FIND "${runtime_dependency_source}" "${sdk_root}/" sdk_dependency_prefix)
  if(sdk_dependency_prefix EQUAL 0 OR runtime_dependency_source STREQUAL sdk_root)
    set(${resolved_source_var} "${runtime_dependency_source}" PARENT_SCOPE)
  else()
    set(${resolved_source_var} "" PARENT_SCOPE)
  endif()
endfunction()

function(copy_runtime_dependency runtime_dependency_source)
  if(NOT EXISTS "${runtime_dependency_source}")
    return()
  endif()

  get_filename_component(runtime_dependency_name "${runtime_dependency_source}" NAME)
  file(MAKE_DIRECTORY "${destination_dir}")
  file(COPY_FILE "${runtime_dependency_source}" "${destination_dir}/${runtime_dependency_name}" ONLY_IF_DIFFERENT)
endfunction()

# Copy the engine library before the search. The wrapper has the runtime path $ORIGIN, so the search finds
# the copy next to the wrapper. A library found only in a search directory makes CMake print a warning.
resolve_sdk_runtime_source("${urho_library_file}" urho_library_source)
if(NOT urho_library_source STREQUAL "")
  copy_runtime_dependency("${urho_library_source}")
endif()

file(GET_RUNTIME_DEPENDENCIES
  LIBRARIES "${target_file}"
  RESOLVED_DEPENDENCIES_VAR resolved_dependencies
  UNRESOLVED_DEPENDENCIES_VAR unresolved_dependencies
  CONFLICTING_DEPENDENCIES_PREFIX conflicting_dependencies
  DIRECTORIES ${search_directories})

# A library that the SDK and the system both supply (MSVCP140.dll on Windows) is a conflict.
# resolve_sdk_runtime_source keeps only the path in the SDK.
foreach(conflicting_dependency_name IN LISTS conflicting_dependencies_FILENAMES)
  list(APPEND resolved_dependencies ${conflicting_dependencies_${conflicting_dependency_name}})
endforeach()

foreach(runtime_dependency IN LISTS resolved_dependencies)
  resolve_sdk_runtime_source("${runtime_dependency}" runtime_dependency_source)

  if(NOT runtime_dependency_source STREQUAL "")
    copy_runtime_dependency("${runtime_dependency_source}")
  endif()
endforeach()
