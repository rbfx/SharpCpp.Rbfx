<Project>
  <!-- MSBuild imports only the nearest Directory.Build.props, so import the repository file first.
       The projects below Rbfx.Examples then see the repository settings (the build output, the native
       paths, the native runtime items of RbfxUserCodeReference). -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <!-- Settings that all examples share. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RbfxPackageVersion Condition="'$(RbfxPackageVersion)' == ''">0.1.0-alpha.46</RbfxPackageVersion>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- The Android, iOS, Wasm and UWP apps set RbfxExampleIsApp in their own Directory.Build.props. They build into
       the shared output folder of BuildOutput.props. A build for another RID has its own root
       (BuildOutput.Settings.props). Workload builds emit warnings, so these apps do not treat warnings as errors. -->
  <PropertyGroup Condition="'$(RbfxExampleIsApp)' == 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
