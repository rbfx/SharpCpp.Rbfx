<Project Sdk="Microsoft.NET.Sdk">
  <!-- NuGet-only twin of Example.Common: the same sources, the SharpCpp.Rbfx.Bindings package and no
       user code. The Android, iOS, Wasm and UWP examples use it. It needs no SDK and no native build.
       The nearest Directory.Build.props (Rbfx.Examples) applies: it has the NuGet-only settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Example.Common</AssemblyName>
    <RootNamespace>Rbfx.Examples.Common</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Top-level files only: the bin and obj folders of Example.Common are not matched. -->
    <Compile Include="../Example.Common/*.cs" LinkBase="Common" />
    <PackageReference Include="SharpCpp.Rbfx.Bindings" Version="$(RbfxPackageVersion)" />
  </ItemGroup>
</Project>
