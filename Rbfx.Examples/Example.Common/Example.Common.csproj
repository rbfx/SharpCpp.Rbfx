<Project Sdk="Microsoft.NET.Sdk">
  <!-- Common code of the examples, built with the native user code Example.UserCode. It has two modes.
       Source mode (RbfxBindingsPackageVersion is empty): the project references the source projects of
       SharpCpp.Rbfx.Bindings and of the source generator. It needs CMAKE_PREFIX_PATH.
       Package mode (RbfxBindingsPackageVersion is set): the project references the NuGet package
       SharpCpp.Rbfx.Bindings of that version. The package carries the source generator. The host
       library is not built. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Example.Common</AssemblyName>
    <RootNamespace>Rbfx.Examples.Common</RootNamespace>
    <DefineConstants>$(DefineConstants);RBFX_USERCODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <RbfxUserCodeReference Include="Example.UserCode" />
  </ItemGroup>

  <!-- Only one bindings assembly may load, so the two modes exclude each other. -->
  <ItemGroup Condition="'$(RbfxBindingsPackageVersion)' == ''">
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RbfxBindingsPackageVersion)' != ''">
    <PackageReference Include="SharpCpp.Rbfx.Bindings" Version="$(RbfxBindingsPackageVersion)" />
  </ItemGroup>
</Project>
