<Project Sdk="Microsoft.NET.Sdk">
  <!-- Source build of Common with user code. Example.Desktop uses it. The mobile examples use
       Example.Common.NuGet, which compiles the same sources against the NuGet package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Example.Common</AssemblyName>
    <RootNamespace>Rbfx.Examples.Common</RootNamespace>
    <DefineConstants>$(DefineConstants);RBFX_USERCODE</DefineConstants>
  </PropertyGroup>

  <!-- Do not add the SharpCpp.Rbfx.Bindings package here: two bindings assemblies would load. -->
  <ItemGroup>
    <RbfxUserCodeReference Include="Example.UserCode" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.SourceGenerator/SharpCpp.Rbfx.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
