<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Items do not flow through ProjectReference. The app owns the item, so the native library of
         Example.UserCode reaches the output folder (RbfxCopyNativeRuntimeToOutput). -->
    <RbfxUserCodeReference Include="Example.UserCode" />
    <PackageReference Include="SharpCpp.Rbfx.CoreData" Version="$(RbfxPackageVersion)" />
    <PackageReference Include="SharpCpp.Rbfx.Data" Version="$(RbfxPackageVersion)" />
    <ProjectReference Include="../Example.Common/Example.Common.csproj" />
  </ItemGroup>
</Project>
