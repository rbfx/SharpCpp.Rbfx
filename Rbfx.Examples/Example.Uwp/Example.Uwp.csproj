<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(RbfxTargetRid)</RuntimeIdentifier>
    <RuntimeIdentifiers>uap-x64</RuntimeIdentifiers>
    <RuntimeIdentifierGraphPath>$(MSBuildProjectDirectory)/RuntimeIdentifierGraph.json</RuntimeIdentifierGraphPath>
    <UseRidGraph>true</UseRidGraph>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot>true</PublishAot>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App.xaml;MainPage.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Items do not flow through ProjectReference. The app owns the item, so the native library of
         Example.UserCode reaches the app (the default RbfxTargetRid is in Directory.Build.props). -->
    <RbfxUserCodeReference Include="Example.UserCode" />
    <ProjectReference Include="../Example.Common/Example.Common.csproj" />
  </ItemGroup>
</Project>
