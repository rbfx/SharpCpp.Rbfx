<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">uap-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>uap-x64</RuntimeIdentifiers>
    <RuntimeIdentifierGraphPath>$(MSBuildProjectDirectory)/RuntimeIdentifierGraph.json</RuntimeIdentifierGraphPath>
    <UseRidGraph>true</UseRidGraph>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot>true</PublishAot>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Update="App.xaml" />
    <Page Update="MainPage.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCpp.Rbfx.Bindings" Version="$(RbfxPackageVersion)" />
  </ItemGroup>
</Project>
