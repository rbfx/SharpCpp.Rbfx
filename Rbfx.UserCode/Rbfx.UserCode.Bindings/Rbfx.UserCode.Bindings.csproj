<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Rbfx.UserCode.Bindings</AssemblyName>
    <SharpCppUserCodeGeneratedDir Condition="'$(SharpCppUserCodeGeneratedDir)' == '' and '$(SharpCppGeneratedDir)' != ''">$(SharpCppGeneratedDir)</SharpCppUserCodeGeneratedDir>
    <SharpCppUserCodeGeneratedDir Condition="'$(SharpCppUserCodeGeneratedDir)' == ''">$(BaseIntermediateOutputPath)generated/rbfx-usercode</SharpCppUserCodeGeneratedDir>
    <NoWarn>$(NoWarn);CS0108;CS0109</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/SharpCpp.Support/SharpCpp.Support.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpCppUserCodeGeneratedDir)' != '' and Exists('$(SharpCppUserCodeGeneratedDir)')">
    <Compile Include="$(SharpCppUserCodeGeneratedDir)/*.cs" LinkBase="Generated" Visible="false" />
  </ItemGroup>
</Project>
