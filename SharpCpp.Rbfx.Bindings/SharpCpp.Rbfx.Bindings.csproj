<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Bindings</AssemblyName>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108;CS0109</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="$(SharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj" />
    <ProjectReference Include="$(SharpCppRoot)/src/SharpCpp.Support/SharpCpp.Support.csproj" />
    <ProjectReference Include="../SharpCpp.Rbfx.SourceGenerator/SharpCpp.Rbfx.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
