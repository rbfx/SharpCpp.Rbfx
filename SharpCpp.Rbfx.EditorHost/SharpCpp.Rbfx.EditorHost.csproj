<Project Sdk="Microsoft.NET.Sdk">
  <!-- The managed plugin that the editor (rbfx_csharp_add_editor) loads at start. It registers the plugins in
       ManagedPlugins/*.dll. CMake builds this project into the folder of the editor executable, with a
       runtimeconfig.json. The SDK build does not use this file: it builds the same sources with a generated project. -->
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.EditorHost</AssemblyName>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>
</Project>
