<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed plugin for ManagedPluginLoadFailureTests. Its type derives from a type of BossPlugin, an assembly with its own
       generated registry. It builds into plugins/ChiefPlugin/. The test project copies the BossPlugin and AttributePlugin assemblies there. -->
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Tests.E2E.ChiefPlugin</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- The test host must not find the plugin next to the test assemblies. Thus the plugin has its own folder. -->
    <BuildOutputPartition>plugins/ChiefPlugin</BuildOutputPartition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
    <ProjectReference Include="../BossPlugin/SharpCpp.Rbfx.Tests.E2E.BossPlugin.csproj" />
  </ItemGroup>
</Project>
