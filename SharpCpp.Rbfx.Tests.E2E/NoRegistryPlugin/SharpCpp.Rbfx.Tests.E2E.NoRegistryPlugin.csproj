<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed plugin without the source generator, so its assembly has no managed type registry. It tests that the registry is the only
       path: the plugin manager refuses to register it. Its RTTI members are written by hand. The test project copies only this assembly to plugins/NoRegistryPlugin/. -->
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Tests.E2E.NoRegistryPlugin</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- No generator on purpose: the repository rule that adds the generators and the check for a missing generator skip this project. -->
    <SharpCppRbfxSkipGeneratorCheck>true</SharpCppRbfxSkipGeneratorCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>
</Project>
