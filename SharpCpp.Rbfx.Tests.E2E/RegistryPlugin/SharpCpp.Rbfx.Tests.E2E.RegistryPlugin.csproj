<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed plugin with a source generated registry, and no member that needs reflection. It builds into plugins/RegistryPlugin/. -->
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Tests.E2E.RegistryPlugin</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- The test host must not find the plugin next to the test assemblies. Thus the plugin has its own folder. -->
    <BuildOutputPartition>plugins/RegistryPlugin</BuildOutputPartition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>
</Project>
