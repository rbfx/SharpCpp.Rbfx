<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Tests.E2E</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(RbfxRunSettingsPath)</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="$(SharpCppRoot)/src/SharpCpp.Std/SharpCpp.Std.csproj" />
    <ProjectReference Include="../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
    <ProjectReference Include="../SharpCpp.Rbfx.NativeHost/SharpCpp.Rbfx.NativeHost.csproj" />
    <ProjectReference Include="../SharpCpp.Rbfx.SourceGenerator/SharpCpp.Rbfx.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="$(SharpCppRoot)/src/SharpCpp.Support.SourceGenerator/SharpCpp.Support.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- The generator tests run the generator in process on a small compilation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The tests read the generator output of the native build tree. The path depends on the CMake preset. -->
  <ItemGroup>
    <AssemblyMetadata Include="RbfxGeneratedDir" Value="$(RbfxGeneratedRoot)/rbfx" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Phase-2 user code: the generated Example.UserCode bindings (by-value ea::string returns). -->
  <ItemGroup>
    <RbfxUserCodeReference Include="Example.UserCode" />
  </ItemGroup>

  <!-- Each test plugin is a separate assembly. Only its dll goes to plugins/<name>/, away from the test assemblies. -->
  <ItemGroup>
    <Compile Remove="TestPlugin/**;AttributePlugin/**;RetryPlugin/**;RegistryPlugin/**;NoRegistryPlugin/**;BossPlugin/**;ChiefPlugin/**" />
    <None Remove="TestPlugin/**;AttributePlugin/**;RetryPlugin/**;RegistryPlugin/**;NoRegistryPlugin/**;BossPlugin/**;ChiefPlugin/**" />
    <ProjectReference Include="TestPlugin/SharpCpp.Rbfx.Tests.E2E.TestPlugin.csproj"
                      OutputItemType="E2ETestPluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="AttributePlugin/SharpCpp.Rbfx.Tests.E2E.AttributePlugin.csproj"
                      OutputItemType="E2EAttributePluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="RetryPlugin/SharpCpp.Rbfx.Tests.E2E.RetryPlugin.csproj"
                      OutputItemType="E2ERetryPluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="RegistryPlugin/SharpCpp.Rbfx.Tests.E2E.RegistryPlugin.csproj"
                      OutputItemType="E2ERegistryPluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="NoRegistryPlugin/SharpCpp.Rbfx.Tests.E2E.NoRegistryPlugin.csproj"
                      OutputItemType="E2ENoRegistryPluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="BossPlugin/SharpCpp.Rbfx.Tests.E2E.BossPlugin.csproj"
                      OutputItemType="E2EBossPluginAssembly"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="ChiefPlugin/SharpCpp.Rbfx.Tests.E2E.ChiefPlugin.csproj"
                      OutputItemType="E2EChiefPluginAssembly"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyE2ETestPlugin" AfterTargets="Build">
    <ItemGroup>
      <_E2ETestPluginFile Include="@(E2ETestPluginAssembly);@(E2ETestPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2ETestPluginFile)"
          Condition="Exists('%(_E2ETestPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/TestPlugin/"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_E2EAttributePluginFile Include="@(E2EAttributePluginAssembly);@(E2EAttributePluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2EAttributePluginFile)"
          Condition="Exists('%(_E2EAttributePluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/AttributePlugin/"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_E2ERetryPluginFile Include="@(E2ERetryPluginAssembly);@(E2ERetryPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2ERetryPluginFile)"
          Condition="Exists('%(_E2ERetryPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/RetryPlugin/"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_E2ERegistryPluginFile Include="@(E2ERegistryPluginAssembly);@(E2ERegistryPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2ERegistryPluginFile)"
          Condition="Exists('%(_E2ERegistryPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/RegistryPlugin/"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_E2ENoRegistryPluginFile Include="@(E2ENoRegistryPluginAssembly);@(E2ENoRegistryPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2ENoRegistryPluginFile)"
          Condition="Exists('%(_E2ENoRegistryPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/NoRegistryPlugin/"
          SkipUnchangedFiles="true" />
    <!-- The plugin directory of BossPlugin also holds the AttributePlugin assembly that BossPlugin references. -->
    <ItemGroup>
      <_E2EBossPluginFile Include="@(E2EBossPluginAssembly);@(E2EBossPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb');@(E2EBossPluginAssembly->'%(RootDir)%(Directory)SharpCpp.Rbfx.Tests.E2E.AttributePlugin.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2EBossPluginFile)"
          Condition="Exists('%(_E2EBossPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/BossPlugin/"
          SkipUnchangedFiles="true" />
    <!-- The plugin directory of ChiefPlugin also holds the BossPlugin and AttributePlugin assemblies. -->
    <ItemGroup>
      <_E2EChiefPluginFile Include="@(E2EChiefPluginAssembly);@(E2EChiefPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb');@(E2EChiefPluginAssembly->'%(RootDir)%(Directory)SharpCpp.Rbfx.Tests.E2E.BossPlugin.dll');@(E2EChiefPluginAssembly->'%(RootDir)%(Directory)SharpCpp.Rbfx.Tests.E2E.AttributePlugin.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_E2EChiefPluginFile)"
          Condition="Exists('%(_E2EChiefPluginFile.FullPath)')"
          DestinationFolder="$(OutDir)plugins/ChiefPlugin/"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
