<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed plugin for ManagedPluginLoadingTests. It builds into plugins/TestPlugin/. -->
  <PropertyGroup>
    <AssemblyName>SharpCpp.Rbfx.Tests.E2E.TestPlugin</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- The test host must not find the plugin next to the test assemblies. Thus the plugin has its own folder. -->
    <BuildOutputPartition>plugins/TestPlugin</BuildOutputPartition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SharpCpp.Ea/SharpCpp.Ea.csproj" />
    <ProjectReference Include="../../SharpCpp.Rbfx.Bindings/SharpCpp.Rbfx.Bindings.csproj" />
  </ItemGroup>
</Project>
