@PACKAGE_INIT@

# find_dependency(Urho3D) can overwrite PACKAGE_PREFIX_DIR (CMake 3.28 and 3.29). Save the prefix and
# expand all the package paths now, before the first find_dependency().
set(_sharpcpp_rbfx_prefix "${PACKAGE_PREFIX_DIR}")
set(_sharpcpp_rbfx_data_dir "@PACKAGE__rbfx_sdk_data_dir@")
set(_sharpcpp_rbfx_include_dir "@PACKAGE__rbfx_sdk_include_dir@")

include(CMakeFindDependencyMacro)

# The installed modules (FindNetHost.cmake, RbfxCSharpDotNet.cmake, RbfxCSharpPlugin.cmake, RbfxCSharpLauncher.cmake, RbfxCSharpData.cmake, RbfxCSharpApplication.cmake, RbfxCSharpProject.cmake, RbfxCSharpAddWrapper.cmake and their helpers).
set(_sharpcpp_rbfx_module_dir "@PACKAGE__rbfx_sdk_module_dir@")
list(PREPEND CMAKE_MODULE_PATH "${_sharpcpp_rbfx_module_dir}")

# The consumer sets Urho3D_DIR or CMAKE_PREFIX_PATH to find the rbfx SDK.
find_dependency(Urho3D CONFIG)

# The host mode and the library type of this SDK.
set(SharpCppRbfx_HOST_MODE "@SHARPCPP_RBFX_HOST_MODE@")
set(SharpCppRbfx_LIBRARY_TYPE "@SHARPCPP_RBFX_NATIVE_LIBRARY_TYPE@")

# The Urho3D target of the consumer must have the library type of this SDK.
get_target_property(_sharpcpp_rbfx_engine_type Urho3D TYPE)
if(SharpCppRbfx_LIBRARY_TYPE STREQUAL "STATIC" AND NOT _sharpcpp_rbfx_engine_type STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "SharpCppRbfx: this SDK has static libraries, but the target Urho3D is not a static library (${_sharpcpp_rbfx_engine_type}). Use an rbfx SDK of the same library type.")
elseif(SharpCppRbfx_LIBRARY_TYPE STREQUAL "SHARED" AND _sharpcpp_rbfx_engine_type STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "SharpCppRbfx: this SDK has shared libraries, but the target Urho3D is a static library. Use an rbfx SDK of the same library type.")
endif()
unset(_sharpcpp_rbfx_engine_type)

# Only a static hostfxr host library links nethost. A shared host library carries it. The shim host has none.
if(@SHARPCPP_RBFX_HOST_NEEDS_NETHOST@)
  find_dependency(NetHost)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SharpCppRbfxTargets.cmake")

# The functions of RbfxCSharpDotNet.cmake run "dotnet".
find_program(DOTNET_EXECUTABLE dotnet)
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpDotNet.cmake")
# rbfx_csharp_add_plugin() makes the C# plugin project.
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpPlugin.cmake")
# rbfx_csharp_add_launcher() links SharpCpp::RbfxHost, so it needs an SDK that has the host library.
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpLauncher.cmake")
# rbfx_csharp_add_data() makes the data target of an application (the paks on mobile and Web).
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpData.cmake")
# rbfx_csharp_package_application() packages a launcher with a plugin and the data.
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpApplication.cmake")
# rbfx_csharp_add_project(), rbfx_csharp_install_application() and rbfx_csharp_find_core_data().
include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpProject.cmake")

# rbfx_csharp_add_wrapper(). The inputs come from this SDK and from the rbfx SDK of the consumer.
if(@SHARPCPP_RBFX_SDK_HAS_USERCODE@)
  set(RBFX_METADATA_FILE "${_sharpcpp_rbfx_data_dir}/metadata/SharpCpp.Rbfx.Bindings.json")
  set(RBFX_ENGINE_UMBRELLA_DIRECTORY "${_sharpcpp_rbfx_data_dir}/metadata")
  # The SDK has no engine generator. The generator commands depend on the metadata file.
  set(RBFX_GENERATED_STAMP "")
  set(SHARPCPP_RBFX_USERCODE_GENERATOR_DLL "${_sharpcpp_rbfx_data_dir}/tools/usercode/Rbfx.UserCode.Generator.dll")
  set(SHARPCPP_CLANG_RESOURCE_DIRECTORY "${_sharpcpp_rbfx_data_dir}/clang-resource")
  # The SharpCpp headers and the headers of SharpCpp.Rbfx are merged in one include folder.
  set(SHARPCPP_RBFX_SHARPCPP_INCLUDE_DIRECTORY "${_sharpcpp_rbfx_include_dir}")
  set(SHARPCPP_RBFX_RBFX_INCLUDE_DIRECTORY "${_sharpcpp_rbfx_include_dir}")
  set(SHARPCPP_RBFX_STALENESS_SCRIPT "${_sharpcpp_rbfx_module_dir}/SharpCppGeneratedStaleness.cmake")

  # The rbfx SDK of the consumer. Urho3D_DIR is <rbfx SDK>/share/Urho3D/CMake.
  set(RBFX_URHO3D_TARGET Urho3D)
  get_filename_component(RBFX_ENGINE_ROOT "${Urho3D_DIR}/../../.." ABSOLUTE)
  if(NOT EXISTS "${RBFX_ENGINE_ROOT}/include/Urho3D")
    message(FATAL_ERROR "SharpCppRbfx: the rbfx SDK headers are not in '${RBFX_ENGINE_ROOT}/include/Urho3D'. Add the installed rbfx SDK to CMAKE_PREFIX_PATH.")
  endif()
  if(NOT RBFX_NATIVE_LIBRARY_TYPE)
    set(RBFX_NATIVE_LIBRARY_TYPE "${SharpCppRbfx_LIBRARY_TYPE}")
  endif()
  if(APPLE)
    set(RBFX_RUNTIME_RPATH "@loader_path")
  else()
    set(RBFX_RUNTIME_RPATH "$ORIGIN")
  endif()

  # The parse flags of the rbfx SDK, written for the compiler of the consumer.
  if(NOT RBFX_SDK_PARSE_LANGUAGE_STANDARD)
    set(RBFX_SDK_PARSE_LANGUAGE_STANDARD "gnu++20")
  endif()
  set(RBFX_SDK_FLAGS_FILE "${CMAKE_BINARY_DIR}/sharpcpp-rbfx/sdk-flags/$<CONFIG>/urho3d-sdk-flags.txt")
  get_property(_sharpcpp_rbfx_flags_written GLOBAL PROPERTY SHARPCPP_RBFX_SDK_FLAGS_WRITTEN)
  if(NOT _sharpcpp_rbfx_flags_written)
    include("${_sharpcpp_rbfx_module_dir}/ExportRbfxSdkParseFlags.cmake")
    sharpcpp_export_rbfx_sdk_parse_flags(
      "${RBFX_URHO3D_TARGET}" "${RBFX_SDK_FLAGS_FILE}" "${RBFX_NATIVE_LIBRARY_TYPE}" "${RBFX_SDK_PARSE_LANGUAGE_STANDARD}")
    set_property(GLOBAL PROPERTY SHARPCPP_RBFX_SDK_FLAGS_WRITTEN TRUE)
  endif()
  file(GLOB_RECURSE RBFX_SDK_INPUT_HEADERS CONFIGURE_DEPENDS
    "${RBFX_ENGINE_ROOT}/include/Urho3D/*.h"
    "${RBFX_ENGINE_ROOT}/include/Urho3D/*.hpp"
    "${RBFX_ENGINE_ROOT}/include/RmlUi/*.h"
    "${RBFX_ENGINE_ROOT}/include/RmlUi/*.hpp"
    "${RBFX_ENGINE_ROOT}/include/ImGui/*.h"
    "${RBFX_ENGINE_ROOT}/include/ImGui/*.hpp")

  # The output folders of the consumer.
  set(SHARPCPP_GENERATED_ROOT "${CMAKE_BINARY_DIR}/generated" CACHE PATH "Root directory for generated binding sources.")
  set(SHARPCPP_NATIVE_OUTPUT_ROOT "${CMAKE_BINARY_DIR}/bin" CACHE PATH "Root directory for native artifacts.")
  set(SHARPCPP_MANAGED_OUTPUT_ROOT "${CMAKE_BINARY_DIR}/bin" CACHE PATH "Root directory for managed artifacts.")

  # The header-only marshaller support of SharpCpp.
  if(NOT TARGET SharpCpp::NativeSupport)
    add_library(SharpCpp::NativeSupport INTERFACE IMPORTED)
    set_target_properties(
      SharpCpp::NativeSupport
      PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_sharpcpp_rbfx_include_dir}"
        INTERFACE_COMPILE_FEATURES cxx_std_20)
    if(WIN32)
      set_property(TARGET SharpCpp::NativeSupport PROPERTY INTERFACE_LINK_LIBRARIES ole32)
    endif()
  endif()

  # The MSBuild files of the written managed project. The consumer can set the variables before find_package().
  # This block exists only when the SDK has the managed assemblies (no bindings package version).
  if(NOT RBFX_CSHARP_MSBUILD_PROPS)
    set(RBFX_CSHARP_MSBUILD_PROPS "${_sharpcpp_rbfx_module_dir}/sdk/SharpCppRbfxUserCode.props")
  endif()
  if(NOT RBFX_CSHARP_MSBUILD_TARGETS)
    set(RBFX_CSHARP_MSBUILD_TARGETS "${_sharpcpp_rbfx_module_dir}/sdk/SharpCppRbfxUserCode.targets")
  endif()
  if(NOT RBFX_CSHARP_MSBUILD_PROPERTIES)
    set(RBFX_CSHARP_MSBUILD_PROPERTIES "SharpCppRbfxIsSdk=true" "SharpCppRbfxManagedDir=${_sharpcpp_rbfx_data_dir}/managed")
  endif()

  include("${_sharpcpp_rbfx_module_dir}/SharpCppOutput.cmake")
  include("${_sharpcpp_rbfx_module_dir}/RbfxCSharpAddWrapper.cmake")

  unset(_sharpcpp_rbfx_flags_written)
else()
  # A package-version SDK has no managed assemblies and no generator inputs.
  function(rbfx_csharp_add_wrapper target)
    message(FATAL_ERROR "rbfx_csharp_add_wrapper(${target}): this SharpCppRbfx SDK was built with a bindings package version. It has no managed assemblies and no user-code generator. Use an SDK from a build without RBFX_CSHARP_BINDINGS_PACKAGE_VERSION.")
  endfunction()
endif()

# Provide path to package root and to the managed assemblies. The source-tree package sets the same variables.
# The managed assemblies are in the SDK only when it was built without a bindings package version.
set(SharpCppRbfx_PACKAGE_ROOT "${_sharpcpp_rbfx_prefix}")
if(@SHARPCPP_RBFX_SDK_HAS_MANAGED@)
  set(SharpCppRbfx_MANAGED_DIR "${_sharpcpp_rbfx_data_dir}/managed")
else()
  unset(SharpCppRbfx_MANAGED_DIR)
endif()
set(SharpCppRbfx_IS_SDK ON)

unset(_sharpcpp_rbfx_module_dir)
unset(_sharpcpp_rbfx_data_dir)
unset(_sharpcpp_rbfx_include_dir)
unset(_sharpcpp_rbfx_prefix)

check_required_components(SharpCppRbfx)
