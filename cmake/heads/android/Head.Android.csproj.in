<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET Android head of the application @RBFX_HEAD_NAME@. rbfx_csharp_package_application (RbfxCSharpApplication.cmake)
       generates this file into the build tree. Do not edit it: CMake writes it again on each configure. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>@RBFX_HEAD_RID@</RuntimeIdentifier>
    <SupportedOSPlatformVersion>@RBFX_HEAD_MIN_API@</SupportedOSPlatformVersion>
    <AssemblyName>@RBFX_HEAD_NAME@.Head</AssemblyName>
    <RootNamespace>Rbfx.Head</RootNamespace>
    <ApplicationId>@RBFX_HEAD_APPLICATION_ID@</ApplicationId>
    <ApplicationTitle>@RBFX_HEAD_NAME@</ApplicationTitle>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The APK has all assemblies also in Debug, so it does not need a fast deployment to a device. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- The workload of .NET for Android tests the configurations Debug and Release only (Microsoft.Android.Sdk.DefaultProperties.targets,
       Microsoft.Android.Sdk.CoreCLR.targets). Each other configuration of CMake, for example RelWithDebInfo, gets the Release
       defaults here. The default runtime of the workload is MonoVM. The head must be AOT compatible, so Release and these
       configurations use Mono AOT (RunAOTCompilation). Only a CoreCLR head (UseMonoRuntime=false) gets ReadyToRun instead. -->
  <PropertyGroup>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release' and '$(RunAOTCompilation)' == '' and '$(AotAssemblies)' == '' and '$(UseMonoRuntime)' != 'false'">true</RunAOTCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'">
    <AndroidManagedSymbols Condition="'$(AndroidManagedSymbols)' == ''">true</AndroidManagedSymbols>
    <AndroidPackageFormats Condition="'$(AndroidPackageFormats)' == ''">aab;apk</AndroidPackageFormats>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == '' and '$(AndroidLinkMode)' != 'None'">true</PublishTrimmed>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == '' and '$(AotAssemblies)' == '' and '$(UseMonoRuntime)' != 'false'">true</RunAOTCompilation>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(UseMonoRuntime)' == 'false'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@RBFX_HEAD_TEMPLATE_DIR@/RbfxApplication.cs" />
@RBFX_HEAD_SOURCES_ITEMS@
    <!-- The source generator of SharpCpp.Rbfx. It makes the type registry (ManagedTypeRegistryAttribute) of the head
         assembly, for the managed types of HEAD_SOURCES. Same items as SharpCppRbfx.Plugin.props. SDK mode: the
         assembly of the SDK. Source mode: the project of the source tree. -->
    <Analyzer Include="$(SharpCppRbfxManagedDir)/SharpCpp.Rbfx.SourceGenerator.dll" Condition="'$(SharpCppRbfxIsSdk)' == 'true'" />
    <ProjectReference Include="$(SharpCppRbfxPackageRoot)/SharpCpp.Rbfx.SourceGenerator/SharpCpp.Rbfx.SourceGenerator.csproj" Condition="'$(SharpCppRbfxIsSdk)' != 'true'"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />

    <!-- The Java side: the SDL activity of the engine and the activity of the head. -->
    <AndroidJavaSource Include="@RBFX_HEAD_SDL_JAVA_DIR@/org/libsdl/app/*.java" Bind="false" />
    <AndroidJavaSource Include="@RBFX_HEAD_DIR@/java/io/urho3d/UrhoActivity.java" Bind="false" />
    <AndroidJavaSource Include="@RBFX_HEAD_TEMPLATE_DIR@/java/org/rbfx/RbfxActivity.java" Bind="false" />

    <!-- The managed plugin of the application. -->
    <ProjectReference Include="@RBFX_HEAD_PLUGIN@" />

    <!-- The native host: attaches the managed function table to the host library (SharpCpp.Rbfx.Host). Only heads
         reference it. SDK mode: the assembly of the SDK. Source mode: the project of the source tree. -->
    <Reference Include="SharpCpp.Rbfx.NativeHost" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Rbfx.NativeHost.dll</HintPath>
    </Reference>
    <ProjectReference Include="$(SharpCppRbfxPackageRoot)/SharpCpp.Rbfx.NativeHost/SharpCpp.Rbfx.NativeHost.csproj" Condition="'$(SharpCppRbfxIsSdk)' != 'true'" />

    <!-- Only native code calls the managed entry points of these assemblies (UnmanagedCallersOnly methods,
         the module initializer of the native host and the plugin class). The trimmer must keep them. -->
    <TrimmerRootAssembly Include="@RBFX_HEAD_PLUGIN_NAME@" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Rbfx.Bindings" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Rbfx.NativeHost" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Support" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Std" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Ea" RootMode="All" />
@RBFX_HEAD_USERCODE_ROOTS@  </ItemGroup>

  <!-- Native libraries and resources of the application. -->
  <ItemGroup>
@RBFX_HEAD_ITEMS@
  </ItemGroup>
</Project>
