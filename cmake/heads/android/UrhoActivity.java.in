package io.urho3d;

import org.libsdl.app.SDLActivity;

import java.util.ArrayList;
import java.util.Arrays;

/**
 * The SDL activity of the engine calls UrhoActivity.getLibraryNames to get the native libraries.
 * The .NET runtime puts its own libraries into the same folder, so this list is fixed and does not
 * scan the folder. The activity loads the libraries in this order. The last library has SDL_main.
 * rbfx_csharp_add_application generates this file.
 */
public class UrhoActivity extends SDLActivity {
    private static final String[] LIBRARIES = { @RBFX_HEAD_JAVA_LIBRARIES@ };

    @Override
    protected String[] getArguments() {
        return new String[0];
    }

    @Override
    public void onBackPressed() {
        finish();
    }

    public static ArrayList<String> getLibraryNames(SDLActivity activity) {
        // System.loadLibrary adds the prefix and the suffix, so the names must not have them.
        ArrayList<String> names = new ArrayList<>();
        for (String library : LIBRARIES) {
            names.add(library.replaceAll("^lib(.*)\\.so$", "$1"));
        }
        return names;
    }
}
