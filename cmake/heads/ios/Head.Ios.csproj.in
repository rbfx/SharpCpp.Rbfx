<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET iOS head of the application @RBFX_HEAD_NAME@. rbfx_csharp_package_application (RbfxCSharpApplication.cmake)
       generates this file into the build tree. Do not edit it: CMake writes it again on each configure. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>@RBFX_HEAD_RID@</RuntimeIdentifier>
    <SupportedOSPlatformVersion>@RBFX_HEAD_MIN_OS@</SupportedOSPlatformVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <AssemblyName>@RBFX_HEAD_NAME@.Head</AssemblyName>
    <RootNamespace>Rbfx.Head</RootNamespace>
    <ApplicationId>@RBFX_HEAD_APPLICATION_ID@</ApplicationId>
    <ApplicationTitle>@RBFX_HEAD_NAME@</ApplicationTitle>
    <AppBundleManifest>@RBFX_HEAD_TEMPLATE_DIR@/Info.plist</AppBundleManifest>
    <!-- The build signs the app only on request (for example EnableCodeSigning=true and CodesignKey=...
         in PROPERTIES). A device runs a signed app only. -->
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
@RBFX_HEAD_PROPERTIES@  </PropertyGroup>

  <PropertyGroup Condition="'$(SharpCppRbfxIsSdk)' != 'true'">
    <!-- Source mode: SharpCpp is the sibling checkout of SharpCpp.Rbfx, as in eng/SharpCpp.Rbfx.Build.props. -->
    <SharpCppRoot Condition="'$(SharpCppRoot)' == ''">$([System.IO.Path]::GetFullPath('$(SharpCppRbfxPackageRoot)/../SharpCpp'))</SharpCppRoot>
  </PropertyGroup>

  <!-- A device build of the .NET iOS SDK compiles the app with full AOT. iOS requires it. The head relies on this default. -->
  <ItemGroup>
    <Compile Include="@RBFX_HEAD_TEMPLATE_DIR@/Program.cs" />
@RBFX_HEAD_SOURCES_ITEMS@
    <!-- The source generator of SharpCpp.Rbfx. It makes the type registry (ManagedTypeRegistryAttribute) of the head
         assembly, for the managed types of HEAD_SOURCES. Same items as SharpCppRbfx.Plugin.props. SDK mode: the
         assembly of the SDK. Source mode: the project of the source tree. -->
    <Analyzer Include="$(SharpCppRbfxManagedDir)/SharpCpp.Rbfx.SourceGenerator.dll" Condition="'$(SharpCppRbfxIsSdk)' == 'true'" />
    <ProjectReference Include="$(SharpCppRbfxPackageRoot)/SharpCpp.Rbfx.SourceGenerator/SharpCpp.Rbfx.SourceGenerator.csproj" Condition="'$(SharpCppRbfxIsSdk)' != 'true'"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(SharpCppRbfxManagedDir)/SharpCpp.Support.SourceGenerator.dll" Condition="'$(SharpCppRbfxIsSdk)' == 'true'" />
    <ProjectReference Include="$(SharpCppRoot)/src/SharpCpp.Support.SourceGenerator/SharpCpp.Support.SourceGenerator.csproj" Condition="'$(SharpCppRbfxIsSdk)' != 'true'"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />

    <!-- The managed plugin of the application. -->
    <ProjectReference Include="@RBFX_HEAD_PLUGIN@" />

    <!-- The native host: attaches the managed function table to the host library (SharpCpp.Rbfx.Host). Only heads
         reference it. SDK mode: the assembly of the SDK. Source mode: the project of the source tree. -->
    <Reference Include="SharpCpp.Rbfx.NativeHost" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Rbfx.NativeHost.dll</HintPath>
    </Reference>

    <!-- SDK mode: the bindings. The plugin project references them with plain Reference items, which are not
         transitive. A HEAD_SOURCES file needs them to compile. Source mode: the project reference of the plugin and
         the NativeHost project bring them. -->
    <Reference Include="SharpCpp.Rbfx.Bindings" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Rbfx.Bindings.dll</HintPath>
    </Reference>
    <Reference Include="SharpCpp.Support" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Support.dll</HintPath>
    </Reference>
    <Reference Include="SharpCpp.Std" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Std.dll</HintPath>
    </Reference>
    <Reference Include="SharpCpp.Ea" Condition="'$(SharpCppRbfxIsSdk)' == 'true'">
      <HintPath>$(SharpCppRbfxManagedDir)/SharpCpp.Ea.dll</HintPath>
    </Reference>
    <ProjectReference Include="$(SharpCppRbfxPackageRoot)/SharpCpp.Rbfx.NativeHost/SharpCpp.Rbfx.NativeHost.csproj" Condition="'$(SharpCppRbfxIsSdk)' != 'true'" />

    <!-- No TrimmerRootAssembly items. Only native code reaches some members of the plugin and of the SharpCpp assemblies
         (the plugin class, UnmanagedCallersOnly methods that native code finds by name). The source generator
         SharpCpp.Rbfx.SourceGenerator writes DynamicDependency roots for them (SharpCpp.Rbfx.Generated.TrimRoots), and
         Program.cs keeps the roots of the head. The trimmer keeps the rest of the code through managed references. -->
  </ItemGroup>

  <!-- Resources of the application. They go into the root folder of the app bundle. -->
  <ItemGroup>
@RBFX_HEAD_ITEMS@
  </ItemGroup>

  <!-- The static libraries of the application (NativeReference items) and their link flags. CMake writes this file
       at the end of the configure step, when all targets of the link exist. -->
  <Import Project="NativeItems.props" />
</Project>
