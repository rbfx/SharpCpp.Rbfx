<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The .NET WebAssembly head of the application @RBFX_HEAD_NAME@. rbfx_csharp_add_application (RbfxCSharpApplication.cmake)
       generates this file into the build tree. Do not edit it: CMake writes it again on each configure. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>@RBFX_HEAD_NAME@.Head</AssemblyName>
    <RootNamespace>Rbfx.Head</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <!-- The engine SDK is compiled with -pthread and -fwasm-exceptions. The runtime must have the same features,
         else wasm-ld does not link the objects. -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <!-- The native application is linked into dotnet.native.wasm. -->
    <WasmBuildNative>true</WasmBuildNative>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <!-- The head links the native host library SharpCpp.Rbfx.Host, so the attach code of the bindings must stay.
         Without this property the trimmer removes the attach code (eng/SharpCpp.Rbfx.NativeHost.targets). -->
    <SharpCppRbfxNativeHost>true</SharpCppRbfxNativeHost>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <PublishDir>bin/publish/</PublishDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@RBFX_HEAD_TEMPLATE_DIR@/Program.cs" />
    <Content Include="wwwroot/index.html;wwwroot/main.js" />

    <!-- The managed plugin of the application. -->
    <ProjectReference Include="@RBFX_HEAD_PLUGIN@" />

    <!-- Only native code calls the managed entry points of these assemblies (UnmanagedCallersOnly methods,
         the module initializer of the bindings and the plugin class). The trimmer must keep them. -->
    <TrimmerRootAssembly Include="@RBFX_HEAD_PLUGIN_NAME@" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Rbfx.Bindings" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Support" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Std" RootMode="All" />
    <TrimmerRootAssembly Include="SharpCpp.Ea" RootMode="All" />

    <!-- The feature switch of eng/SharpCpp.Rbfx.NativeHost.targets. A source build or an SDK build of the head
         does not import that file, so the head sets the switch itself. The file adds no second item. -->
    <RuntimeHostConfigurationOption Include="SharpCpp.Rbfx.NativeHost" Value="true" Trim="true" />

    <!-- main.js calls the native entry (heads/wasm/RbfxWebMain.cpp) after Program.Main. -->
    <EmccExportedFunction Include="_@RBFX_HEAD_ENTRY@" />
  </ItemGroup>

  <!-- The link flags of the engine on the web. The list is the same as in eng/SharpCpp.Rbfx.NativeItems.targets.
       The marker stops a second copy from that file (a runtime package that the plugin references). -->
  <PropertyGroup>
    <EmccExtraLDFlags>$(EmccExtraLDFlags);--bind;-sWASM=1;-sFETCH=1;-fwasm-exceptions;-sFORCE_FILESYSTEM=1;-lidbfs.js;-sALLOW_MEMORY_GROWTH=1;--no-heap-copy;-sMIN_WEBGL_VERSION=2;-sMAX_WEBGL_VERSION=2;-sGL_ENABLE_GET_PROC_ADDRESS=1;-sFULL_ES3=1;-sDISABLE_DEPRECATED_FIND_EVENT_TARGET_BEHAVIOR=0</EmccExtraLDFlags>
    <_RbfxEmccFlagsApplied>true</_RbfxEmccFlagsApplied>
  </PropertyGroup>

  <!-- The static libraries and the objects of the application and their link flags. CMake writes this file
       at the end of the configure step, when all targets of the link exist. -->
  <Import Project="NativeItems.props" />
</Project>
