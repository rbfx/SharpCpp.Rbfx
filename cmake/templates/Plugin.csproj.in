<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by rbfx_csharp_add_plugin(@RBFX_PLUGIN_NAME@). Do not edit. -->
  <Import Project="$(MSBuildThisFileDirectory)SharpCppRbfx.Plugin.props" />

  <PropertyGroup>
    <AssemblyName>@RBFX_PLUGIN_NAME@</AssemblyName>
    <RootNamespace>@RBFX_PLUGIN_NAME@</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
