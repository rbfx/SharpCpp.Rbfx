<Project InitialTargets="BuildOutputCheckOwner">
  <!-- Build output partitions. This is a copyable file. Keep all copies the same, byte for byte.
       BuildOutput.props adds this file to BeforeMicrosoftNETSdkTargets.
       A project can set BuildOutputPartition to a folder name. Its output then goes to bin/<Config>/<partition>/.
       A project output stays in its partition. A project in another partition does not copy it.
       An app (Exe or WinExe) gets a resolver that loads assemblies and native libraries from the other folders. -->
  <PropertyGroup Condition="'$(BuildOwnerDir)' != ''">
    <OutputPath Condition="'$(BuildOutputPartition)' != ''">$([MSBuild]::NormalizeDirectory('$(OutputPath)', '$(BuildOutputPartition)'))</OutputPath>
    <BuildOutputBinDir>$([MSBuild]::NormalizeDirectory('$(BuildOutputRoot)', 'bin', '$(Configuration)'))</BuildOutputBinDir>
  </PropertyGroup>

  <Target Name="BuildOutputCheckOwner">
    <Error Condition="'$(BuildOwnerDir)' == ''"
           Text="BuildOutput.props has no owner folder. Set BuildOutputOwnerDir before the import of BuildOutput.props, or build a solution." />
  </Target>

  <!-- The output of this project tells its consumers its root and its partition. -->
  <Target Name="BuildOutputMarkTargetPath" AfterTargets="GetTargetPathWithTargetPlatformMoniker">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Update="@(TargetPathWithTargetPlatformMoniker)"
                                           BuildOutputRoot="$(BuildOutputRoot)"
                                           BuildOutputPartition="$(BuildOutputPartition)" />
    </ItemGroup>
  </Target>

  <!-- A project output from another partition of the same root stays there. This project does not copy it. -->
  <Target Name="BuildOutputKeepPartitionReferences" AfterTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <_BuildOutputOwnDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_BuildOutputOwnDir>
    </PropertyGroup>
    <ItemGroup>
      <_BuildOutputForeign Include="@(ReferenceCopyLocalPaths)"
                           Condition="'%(ReferenceCopyLocalPaths.BuildOutputRoot)' == '$(BuildOutputRoot)' and '%(ReferenceCopyLocalPaths.BuildOutputPartition)' != '$(BuildOutputPartition)'" />
      <ReferenceCopyLocalPaths Remove="@(_BuildOutputForeign)" />
      <!-- Not Update="@(_BuildOutputForeign)": in a target, an empty Update list changes all items. -->
      <ReferencePath Condition="'%(ReferencePath.BuildOutputRoot)' == '$(BuildOutputRoot)' and '%(ReferencePath.BuildOutputPartition)' != '$(BuildOutputPartition)'">
        <CopyLocal>false</CopyLocal>
      </ReferencePath>
    </ItemGroup>
    <!-- The probe folders are the folders of these outputs. An output folder below bin/<Config>/ (a partition or a TFM folder)
         also probes bin/<Config>/, which has the native files of CMake. -->
    <ItemGroup Condition="'@(_BuildOutputForeign)' != ''">
      <_BuildOutputProbeDir Include="$([MSBuild]::MakeRelative('$(_BuildOutputOwnDir)', '%(_BuildOutputForeign.RootDir)%(_BuildOutputForeign.Directory)'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(_BuildOutputOwnDir)' != '$(BuildOutputBinDir)'">
      <_BuildOutputProbeDir Include="$([MSBuild]::MakeRelative('$(_BuildOutputOwnDir)', '$(BuildOutputBinDir)'))" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <_BuildOutputResolverCode><![CDATA[
// <auto-generated/>
// Generated by BuildOutput.targets. The app loads assemblies and native libraries from other folders of its build root.
#nullable enable
internal static class BuildOutputResolver
{
    [System.Runtime.CompilerServices.ModuleInitializer]
    internal static void Initialize()
    {
        if (System.AppContext.GetData("BuildOutput.ProbeDirs") is not string value)
            return%3B
        var dirs = new System.Collections.Generic.List<string> { System.AppContext.BaseDirectory }%3B
        foreach (var dir in value.Split('|', System.StringSplitOptions.RemoveEmptyEntries))
            dirs.Add(System.IO.Path.GetFullPath(System.IO.Path.Combine(System.AppContext.BaseDirectory, dir)))%3B
        var context = System.Runtime.Loader.AssemblyLoadContext.Default%3B
        context.Resolving += (context, name) =>
        {
            foreach (var dir in dirs)
            {
                var path = System.IO.Path.Combine(dir, name.Name + ".dll")%3B
                if (System.IO.File.Exists(path))
                    return context.LoadFromAssemblyPath(path)%3B
            }
            return null%3B
        }%3B
        context.ResolvingUnmanagedDll += (assembly, name) =>
        {
            var files = System.OperatingSystem.IsWindows() ? new[] { name, name + ".dll" }
                : System.OperatingSystem.IsMacOS() ? new[] { name, "lib" + name + ".dylib", name + ".dylib" }
                : new[] { name, "lib" + name + ".so", name + ".so" }%3B
            foreach (var dir in dirs)
            {
                foreach (var file in files)
                {
                    if (System.Runtime.InteropServices.NativeLibrary.TryLoad(System.IO.Path.Combine(dir, file), out var handle))
                        return handle%3B
                }
            }
            return System.IntPtr.Zero%3B
        }%3B
    }
}
]]></_BuildOutputResolverCode>
  </PropertyGroup>

  <!-- The probe folders go into runtimeconfig.json. Thus a change of the folders does not compile the app again. -->
  <Target Name="BuildOutputAddResolver"
          AfterTargets="BuildOutputKeepPartitionReferences"
          BeforeTargets="CoreCompile;GenerateBuildRuntimeConfigurationFiles"
          Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '@(_BuildOutputProbeDir)' != ''">
    <PropertyGroup>
      <_BuildOutputResolverFile>$(IntermediateOutputPath)BuildOutputResolver.g.cs</_BuildOutputResolverFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildOutputResolverFile)" Lines="$(_BuildOutputResolverCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildOutputResolverFile)" />
      <FileWrites Include="$(_BuildOutputResolverFile)" />
      <RuntimeHostConfigurationOption Include="BuildOutput.ProbeDirs" Value="@(_BuildOutputProbeDir->Distinct(), '|')" />
    </ItemGroup>
  </Target>
</Project>
