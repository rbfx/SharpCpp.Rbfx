<Project>
  <Import Project="$(MSBuildThisFileDirectory)SharpCpp.Rbfx.Rid.props" Condition="'$(RbfxRidPropsImported)' != 'true'" />
  <PropertyGroup>
    <SharpCppRbfxRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</SharpCppRbfxRoot>
    <!-- SharpCpp is consumed as a sibling checkout; override SharpCppRoot to use another one. -->
    <SharpCppRoot Condition="'$(SharpCppRoot)' == ''">$([System.IO.Path]::GetFullPath('$(SharpCppRbfxRoot)/../SharpCpp'))</SharpCppRoot>

    <!-- SDK root chain: explicit, CMAKE_PREFIX_PATH (host only), build/sdk/<target rid>, build/sdk/<host rid> (host only), legacy ../../rbfx-sdk (host only). -->
    <RbfxSdkRoot Condition="'$(RbfxSdkRoot)' == '' and '$(RbfxIsCrossRid)' != 'true' and '$(CMAKE_PREFIX_PATH)' != '' and Exists('$(CMAKE_PREFIX_PATH)/share/Urho3D/CMake/Urho3DConfig.cmake')">$(CMAKE_PREFIX_PATH)</RbfxSdkRoot>
    <RbfxSdkRoot Condition="'$(RbfxSdkRoot)' == '' and '$(RbfxTargetRid)' != '' and Exists('$(SharpCppRbfxRoot)/build/sdk/$(RbfxTargetRid)/share/Urho3D/CMake/Urho3DConfig.cmake')">$(SharpCppRbfxRoot)/build/sdk/$(RbfxTargetRid)</RbfxSdkRoot>
    <RbfxSdkRoot Condition="'$(RbfxSdkRoot)' == '' and '$(RbfxIsCrossRid)' != 'true' and Exists('$(SharpCppRbfxRoot)/build/sdk/$(RbfxHostRid)/share/Urho3D/CMake/Urho3DConfig.cmake')">$(SharpCppRbfxRoot)/build/sdk/$(RbfxHostRid)</RbfxSdkRoot>
    <RbfxSdkRoot Condition="'$(RbfxSdkRoot)' == '' and '$(RbfxIsCrossRid)' != 'true' and Exists('$(SharpCppRbfxRoot)/../../rbfx-sdk')">$([System.IO.Path]::GetFullPath('$(SharpCppRbfxRoot)/../../rbfx-sdk'))</RbfxSdkRoot>

    <!-- BuildOutput.props sets the build root. All outputs of this repository go below it. -->
    <SharpCppBuildRoot>$([System.IO.Path]::GetDirectoryName('$(BuildOutputRoot)'))</SharpCppBuildRoot>
    <!-- The restore files stay below the host root. BuildOutput.Settings.props of this repository sets it for a cross build.
         RbfxRestoreRid adds a folder for a target RID, so builds of different RIDs never write the same project.assets.json.
         It is an explicit global property, because the restore of a referenced project sees only global properties. -->
    <RbfxHostBuildRoot Condition="'$(RbfxHostBuildRoot)' == ''">$(BuildOutputRoot)</RbfxHostBuildRoot>
    <RbfxRestoreRoot>$([MSBuild]::NormalizeDirectory('$(RbfxHostBuildRoot)', 'obj', 'restore', '$(RbfxRestoreRid)'))</RbfxRestoreRoot>
    <!-- The build system that drives this one defines the configuration set (CMake passes -p:Configurations=...). The native
         libraries use the CMake configuration name, so $(Configuration) names their folder. -->
    <Configurations Condition="'$(Configurations)' == ''">Debug;Release</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- The managed and the native files of a configuration share one folder: bin/<Config>/. -->
    <SharpCppManagedOutputRoot>$(SharpCppBuildRoot)/bin</SharpCppManagedOutputRoot>
    <SharpCppNativeOutputRoot>$(SharpCppBuildRoot)/bin</SharpCppNativeOutputRoot>
    <SharpCppOutputDir>$(SharpCppManagedOutputRoot)/$(Configuration)</SharpCppOutputDir>

    <!-- The one map from a RID to the CMake configure preset of CMakePresets.json. The RID is the target RID, or the host RID for a host build.
         An explicit RbfxNativePreset overrides the map. A RID without an entry leaves the preset empty. -->
    <RbfxPresetRid>$(RbfxTargetRid)</RbfxPresetRid>
    <RbfxPresetRid Condition="'$(RbfxPresetRid)' == ''">$(RbfxHostRid)</RbfxPresetRid>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'linux-x64'">linux-gcc-x64-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'osx-arm64'">macos-clang-arm64-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'win-x64'">windows-msvc-x64-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'android-arm'">android-clang-arm-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'android-arm64'">android-clang-arm64-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'android-x64'">android-clang-x64-dll</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'ios-arm64'">ios-clang-arm64-lib</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'browser-wasm'">web-emscripten-wasm-lib</RbfxNativePreset>
    <RbfxNativePreset Condition="'$(RbfxNativePreset)' == '' and '$(RbfxPresetRid)' == 'uap-x64'">uwp-msvc-x64-dll</RbfxNativePreset>
    <RbfxCMakeCommand Condition="'$(RbfxCMakeCommand)' == ''">cmake</RbfxCMakeCommand>
    <RbfxNativeBuildDir Condition="'$(RbfxNativeBuildDir)' == ''">$(SharpCppBuildRoot)/native/$(RbfxNativePreset)</RbfxNativeBuildDir>
    <RbfxNativeLockFile Condition="'$(RbfxNativeLockFile)' == ''">$(RbfxNativeBuildDir)/sharpcpp-rbfx-native.lock</RbfxNativeLockFile>
    <!-- RbfxBindingsPackageVersion is set by consumers that build with packages from a local feed (built by package.sh or CI). Unset means
         source build. When set, the user-code bindings project references the package SharpCpp.Rbfx.Bindings
         of this version and the native configure skips the host library. The version is part of the
         configure arguments, so a new version configures again. -->
    <!-- A tree can hold a cache from another build of the same preset. User-code output is always on for builds of this project. -->
    <RbfxNativeConfigureArguments>$(RbfxNativeConfigureArguments) -DRBFX_BUILD_USERCODE=ON</RbfxNativeConfigureArguments>
    <RbfxNativeConfigureArguments Condition="'$(RbfxBindingsPackageVersion)' != ''">$(RbfxNativeConfigureArguments) -DRBFX_CSHARP_BINDINGS_PACKAGE_VERSION=$(RbfxBindingsPackageVersion) -DRBFX_BUILD_HOST=OFF</RbfxNativeConfigureArguments>
    <!-- A source build clears the package values that a package build left in the same tree. -->
    <RbfxNativeConfigureArguments Condition="'$(RbfxBindingsPackageVersion)' == ''">$(RbfxNativeConfigureArguments) -DRBFX_CSHARP_BINDINGS_PACKAGE_VERSION=</RbfxNativeConfigureArguments>
    <RbfxNativeConfigureArguments Condition="'$(RbfxBindingsPackageVersion)' == '' and '$(RbfxIsCrossRid)' != 'true'">$(RbfxNativeConfigureArguments) -DRBFX_BUILD_HOST=ON</RbfxNativeConfigureArguments>
    <!-- The preset of iOS has no toolchain file, because the toolchain file is part of the engine SDK. The path of the SDK is known here only. -->
    <RbfxNativeConfigureArguments Condition="'$(RbfxNativePreset)' == 'ios-clang-arm64-lib' and '$(RbfxSdkRoot)' != ''">$(RbfxNativeConfigureArguments) -DCMAKE_TOOLCHAIN_FILE=$(RbfxSdkRoot)/share/Urho3D/CMake/Toolchains/IOS.cmake</RbfxNativeConfigureArguments>
    <RbfxGeneratedRoot>$(RbfxNativeBuildDir)/generated</RbfxGeneratedRoot>
    <RbfxGeneratedDir>$(RbfxGeneratedRoot)/rbfx</RbfxGeneratedDir>
    <RbfxGeneratedStamp>$(RbfxGeneratedDir)/generate.stamp</RbfxGeneratedStamp>

    <RbfxSharedLibraryPrefix Condition="$([MSBuild]::IsOSPlatform(`Linux`)) or $([MSBuild]::IsOSPlatform(`OSX`))">lib</RbfxSharedLibraryPrefix>
    <RbfxSharedLibrarySuffix Condition="$([MSBuild]::IsOSPlatform(`Linux`))">.so</RbfxSharedLibrarySuffix>
    <RbfxSharedLibrarySuffix Condition="$([MSBuild]::IsOSPlatform(`OSX`))">.dylib</RbfxSharedLibrarySuffix>
    <RbfxSharedLibrarySuffix Condition="$([MSBuild]::IsOSPlatform(`Windows`))">.dll</RbfxSharedLibrarySuffix>
    <RbfxSharedLibraryPrefix Condition="$(RbfxTargetRid.StartsWith('android-')) or '$(RbfxTargetRid)' == 'ios-arm64' or '$(RbfxTargetRid)' == 'browser-wasm'">lib</RbfxSharedLibraryPrefix>
    <RbfxSharedLibrarySuffix Condition="$(RbfxTargetRid.StartsWith('android-'))">.so</RbfxSharedLibrarySuffix>
    <RbfxSharedLibrarySuffix Condition="'$(RbfxTargetRid)' == 'ios-arm64' or '$(RbfxTargetRid)' == 'browser-wasm'">.a</RbfxSharedLibrarySuffix>
    <DefineConstants Condition="'$(RbfxTargetRid)' == 'ios-arm64'">$(DefineConstants);SHARPCPP_STATIC_RUNTIME</DefineConstants>
    <DefineConstants Condition="'$(RbfxTargetRid)' == 'browser-wasm'">$(DefineConstants);SHARPCPP_STATIC_RUNTIME;SHARPCPP_BROWSER_WASM</DefineConstants>
    <RbfxNativeLibraryPath>$(SharpCppNativeOutputRoot)/$(Configuration)/$(RbfxSharedLibraryPrefix)SharpCpp.Rbfx.Native$(RbfxSharedLibrarySuffix)</RbfxNativeLibraryPath>
    <RbfxRunSettingsPath>$(SharpCppOutputDir)/SharpCpp.Rbfx.Tests.runsettings</RbfxRunSettingsPath>

    <SharpCppSdkVersion>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(MSBuildSDKsPath)'))))</SharpCppSdkVersion>
    <!-- A host that is not the dotnet CLI (for example Visual Studio MSBuild.exe) has no SDK version in this path. -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(SharpCppSdkVersion)', '^[0-9]+\.'))">net$([System.Version]::Parse('$(SharpCppSdkVersion)').Major).0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NuGetAudit>false</NuGetAudit>

    <!-- The one exception to BuildOutput.props: the restore files of all RIDs stay below the host root (see RbfxRestoreRoot). -->
    <MSBuildProjectExtensionsPath>$(RbfxRestoreRoot)$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SharpCppBuildRoot)/**;$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The SDK sets Optimize for Debug and Release only. Each other configuration (for example RelWithDebInfo)
       builds like Release: optimized code, the symbol RELEASE and portable debug symbols. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'">
    <Optimize Condition="'$(Optimize)' == ''">true</Optimize>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>

  <!-- Packaging and CI builds map the directories of the build machine to fixed names, so a pdb and a dll hold no local path.
       RbfxPackaging is set by packaging/nuget/package.sh, which also loads the file through CustomAfterMicrosoftCommonProps. A local developer build keeps the real paths for the debugger. -->
  <Import Project="$(MSBuildThisFileDirectory)SharpCpp.Rbfx.Deterministic.props" Condition="('$(RbfxPackaging)' == 'true' or '$(GITHUB_ACTIONS)' == 'true') and '$(CustomAfterMicrosoftCommonProps)' == ''" />

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SharpCpp.Rbfx.Bindings'">
    <RbfxConsumedGeneratedDir>$(RbfxGeneratedDir)</RbfxConsumedGeneratedDir>
    <RbfxConsumedGeneratedStamp>$(RbfxGeneratedStamp)</RbfxConsumedGeneratedStamp>
    <RbfxConsumedNativeLibraryPath>$(RbfxNativeLibraryPath)</RbfxConsumedNativeLibraryPath>
  </PropertyGroup>
</Project>
