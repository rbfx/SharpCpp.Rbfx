<Project>
  <Import Project="$(MSBuildThisFileDirectory)SharpCpp.Rbfx.Consumer.targets" />

  <PropertyGroup>
    <!-- Libraries are loaded through their host's dependency file; executables need their own
         so NuGet native runtime assets (libClangSharp) resolve. -->
    <GenerateDependencyFile Condition="'$(RbfxIsTestProject)' != 'true' and '$(OutputType)' != 'Exe'">false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(RbfxConsumedGeneratedDir)' != ''">
    <Compile Include="$(RbfxConsumedGeneratedDir)/**/*.g.cs"
             LinkBase="Generated"
             Visible="false"
             RbfxGeneratedSource="true"
             Condition="Exists('$(RbfxConsumedGeneratedDir)')" />
    <ProjectReference Include="$(SharpCppRbfxRoot)/native/SharpCpp.Rbfx.Native/SharpCpp.Rbfx.Native.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- A consumer project declares <RbfxUserCodeReference Include="<CMake target>" /> for each target of
       rbfx_csharp_add_usercode(). The native project reference makes the native build and the generation
       run first. They also write the managed bindings project below $(RbfxGeneratedRoot)/usercode/<target>/. -->
  <ItemGroup Condition="'@(RbfxUserCodeReference)' != '' and '$(RbfxConsumedGeneratedDir)' == ''">
    <ProjectReference Include="$(SharpCppRbfxRoot)/native/SharpCpp.Rbfx.Native/SharpCpp.Rbfx.Native.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="RbfxResolveUserCodeReferences"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'@(RbfxUserCodeReference)' != ''">
    <!-- RbfxGeneratedRoot comes from Build.props, which the consumer project evaluates with its own
         RbfxTargetRid (project property or global property). So the usercode csproj directory
         already lies in the tree of the target RID. The generated project gets the same RID below. -->
    <PropertyGroup>
      <_RbfxTargetRidProperty Condition="'$(RbfxTargetRid)' != ''">;RbfxTargetRid=$(RbfxTargetRid)</_RbfxTargetRidProperty>
    </PropertyGroup>
    <ItemGroup>
      <_RbfxUserCodeCandidate Include="$(RbfxGeneratedRoot)/usercode/%(RbfxUserCodeReference.Identity)/*.csproj"
                              RbfxUserCodeId="%(RbfxUserCodeReference.Identity)" />
    </ItemGroup>
    <Error Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(RbfxGeneratedRoot)/usercode/%(RbfxUserCodeReference.Identity)')"
           Text="The managed project directory of RbfxUserCodeReference '%(RbfxUserCodeReference.Identity)' is missing: '$(RbfxGeneratedRoot)/usercode/%(RbfxUserCodeReference.Identity)'. Check that the CMake target calls rbfx_csharp_add_usercode()." />
    <Error Condition="'$(DesignTimeBuild)' != 'true' and $([System.IO.Directory]::GetFiles('$(RbfxGeneratedRoot)/usercode/%(RbfxUserCodeReference.Identity)', '*.csproj').Length) != 1"
           Text="Expected exactly one *.csproj for RbfxUserCodeReference '%(RbfxUserCodeReference.Identity)' in '$(RbfxGeneratedRoot)/usercode/%(RbfxUserCodeReference.Identity)'." />

    <!-- Each Restore call uses its own session id. The generated project is not in the solution. -->
    <MSBuild Projects="@(_RbfxUserCodeCandidate)"
             Targets="Restore"
             Properties="Configuration=$(Configuration)$(_RbfxTargetRidProperty);RestoreRecursive=false;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'$(DesignTimeBuild)' != 'true'" />
    <MSBuild Projects="@(_RbfxUserCodeCandidate)"
             Targets="Build"
             Properties="Configuration=$(Configuration)$(_RbfxTargetRidProperty)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'$(DesignTimeBuild)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_RbfxUserCodeAssembly" />
    </MSBuild>
    <MSBuild Projects="@(_RbfxUserCodeCandidate)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)$(_RbfxTargetRidProperty)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'$(DesignTimeBuild)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_RbfxUserCodeAssembly" />
    </MSBuild>

    <ItemGroup>
      <Reference Include="@(_RbfxUserCodeAssembly)" Private="true" />
    </ItemGroup>
  </Target>

  <Target Name="RbfxSetProjectReferenceProperties"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences">
    <!-- A project property RbfxTargetRid is not a global property, so it does not flow to referenced
         projects (for example the native project). Pass it in SetConfiguration. Empty for the host build. -->
    <PropertyGroup>
      <_RbfxTargetRidProperty Condition="'$(RbfxTargetRid)' != ''">;RbfxTargetRid=$(RbfxTargetRid)</_RbfxTargetRidProperty>
    </PropertyGroup>
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)">
        <SetConfiguration>%(_MSBuildProjectReferenceExistent.SetConfiguration);Configuration=$(Configuration)$(_RbfxTargetRidProperty)</SetConfiguration>
        <GlobalPropertiesToRemove>TargetFramework;RuntimeIdentifier;SelfContained</GlobalPropertiesToRemove>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>

  <Target Name="RbfxIncludeGeneratedSources"
          BeforeTargets="CoreCompile"
          Condition="'$(RbfxConsumedGeneratedDir)' != ''">
    <ItemGroup>
      <Compile Remove="@(Compile)"
               Condition="'%(Compile.RbfxGeneratedSource)' == 'true' and !Exists('%(Compile.FullPath)')" />
      <RbfxRequiredGeneratedSources Include="$(RbfxConsumedGeneratedDir)/**/*.g.cs"
                                    Condition="Exists('$(RbfxConsumedGeneratedDir)')" />
      <Compile Include="@(RbfxRequiredGeneratedSources)"
               Exclude="@(Compile)"
               LinkBase="Generated"
               Visible="false"
               RbfxGeneratedSource="true" />
    </ItemGroup>

    <Error Condition="'@(RbfxRequiredGeneratedSources)' == ''"
           Text="Generated sources are missing for $(MSBuildProjectName) at '$(RbfxConsumedGeneratedDir)'." />
    <Error Condition="!Exists('$(RbfxConsumedGeneratedStamp)')"
           Text="Generation did not produce '$(RbfxConsumedGeneratedStamp)'." />
    <Error Condition="!Exists('$(RbfxConsumedNativeLibraryPath)')"
           Text="The native build did not produce '$(RbfxConsumedNativeLibraryPath)'." />
  </Target>

  <Target Name="RbfxStageNativeTestRuntime"
          AfterTargets="Build"
          Condition="'$(RbfxIsTestProject)' == 'true'">
    <ItemGroup>
      <RbfxNativeTestRuntime Include="$(SharpCppOutputDir)/*.so;$(SharpCppOutputDir)/*.so.*"
                             Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <RbfxNativeTestRuntime Include="$(SharpCppOutputDir)/*.dylib"
                             Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <RbfxNativeTestRuntime Include="$(SharpCppOutputDir)/*.dll"
                             Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Copy SourceFiles="@(RbfxNativeTestRuntime)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
