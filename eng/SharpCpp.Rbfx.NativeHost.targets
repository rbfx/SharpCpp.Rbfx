<Project>
  <!-- The feature switch of the native host. The MSBuild property SharpCppRbfxNativeHost is false by default.
       An application that a native library hosts (a head with the host library SharpCpp.Rbfx.Host: Android,
       iOS or browser-wasm) sets it to true. The property becomes the AppContext switch and the trimmer
       feature "SharpCpp.Rbfx.NativeHost". If it is false, the trimmer removes the attach code of
       SharpCpp.Rbfx.Bindings (Urho3D.Plugins.NativeHostShim) and its imports of the host library.
       Source builds import this file from SharpCpp.Rbfx.Build.targets. The Bindings NuGet package
       has it in buildTransitive/. -->
  <PropertyGroup>
    <SharpCppRbfxNativeHost Condition="'$(SharpCppRbfxNativeHost)' == ''">false</SharpCppRbfxNativeHost>
  </PropertyGroup>

  <!-- A second import (source build and package together) or an item of the head adds no second item. -->
  <ItemGroup Condition="'@(RuntimeHostConfigurationOption->WithMetadataValue('Identity', 'SharpCpp.Rbfx.NativeHost'))' == ''">
    <RuntimeHostConfigurationOption Include="SharpCpp.Rbfx.NativeHost"
                                    Value="$(SharpCppRbfxNativeHost)"
                                    Trim="true" />
  </ItemGroup>
</Project>
