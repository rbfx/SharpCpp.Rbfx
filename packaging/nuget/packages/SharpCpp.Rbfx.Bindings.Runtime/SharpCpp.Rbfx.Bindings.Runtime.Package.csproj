<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(SharpCppPackageTargetFramework)' != ''">$(SharpCppPackageTargetFramework)</TargetFramework>
    <SharpCppRuntimePackageId Condition="'$(SharpCppRuntimePackageId)' == ''">SharpCpp.Rbfx.Bindings.runtime.$(SharpCppRuntimeIdentifier)</SharpCppRuntimePackageId>
    <PackageId>$(SharpCppRuntimePackageId)</PackageId>
    <Title>$(SharpCppRuntimePackageId)</Title>
    <Version>$(PackageVersion)</Version>
    <Authors>rbfx contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rbfx/rbfx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rbfx/SharpCpp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Native runtime assets for SharpCpp rbfx bindings ($(SharpCppRuntimeIdentifier)).</Description>
    <PackageTags>rbfx SharpCpp Urho3D native runtime $(SharpCppRuntimeIdentifier)</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCpp.Rbfx.Bindings" Version="$(PackageVersion)" Condition="'$(SharpCppUnionPackage)' != 'true'" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/lib/$(TargetFramework)/*" Pack="true" PackagePath="runtimes/$(SharpCppRuntimeIdentifier)/lib/$(TargetFramework)/%(Filename)%(Extension)" />
    <None Include="$(SharpCppNuGetStageRoot)/managed/analyzers/dotnet/cs/*" Pack="true" PackagePath="analyzers/dotnet/cs/%(Filename)%(Extension)" Condition="'$(SharpCppUnionPackage)' != 'true'" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/native/*" Pack="true" PackagePath="runtimes/$(SharpCppRuntimeIdentifier)/native/%(Filename)%(Extension)" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/metadata/*" Pack="true" PackagePath="runtimes/$(SharpCppRuntimeIdentifier)/metadata/%(Filename)%(Extension)" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/metadata/*" Pack="true" PackagePath="runtimes/$(SharpCppAdditionalRuntimeIdentifier)/metadata/%(Filename)%(Extension)" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' != ''" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/buildTransitive/*" Pack="true" PackagePath="buildTransitive/%(Filename)%(Extension)" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/lib/$(TargetFramework)/*" Pack="true" PackagePath="runtimes/$(SharpCppAdditionalRuntimeIdentifier)/lib/$(TargetFramework)/%(Filename)%(Extension)" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' != ''" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/native-assets/*" Pack="true" PackagePath="native-assets/$(SharpCppAdditionalRuntimeIdentifier)/%(Filename)%(Extension)" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' == 'linux-x64'" />
    <None Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/buildTransitive/*" Pack="true" PackagePath="buildTransitive/%(Filename)%(Extension)" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' != ''" />
    <None Include="LinuxX64NativeAssets.targets" Pack="true" PackagePath="buildTransitive/SharpCpp.Rbfx.Bindings.runtime.unix-x64.targets" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' == 'linux-x64'" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="ValidateSharpCppRuntimePackageInputs" BeforeTargets="Pack">
    <Error Condition="'$(SharpCppNuGetStageRoot)' == ''" Text="SharpCppNuGetStageRoot must point to staged package files." />
    <Error Condition="'$(SharpCppRuntimeIdentifier)' == ''" Text="SharpCppRuntimeIdentifier must be set." />
    <ItemGroup>
      <SharpCppRuntimeNativeFiles Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/native/*" />
      <SharpCppRuntimeNativeFiles Include="$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/native/*" Condition="'$(SharpCppAdditionalRuntimeIdentifier)' != ''" />
    </ItemGroup>
    <Error Condition="'@(SharpCppRuntimeNativeFiles)' == ''" Text="No native runtime files were staged for $(SharpCppRuntimeIdentifier)." />
    <Error Condition="!Exists('$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/metadata/SharpCpp.Rbfx.Bindings.json') or !Exists('$(SharpCppNuGetStageRoot)/runtime/$(SharpCppRuntimeIdentifier)/metadata/SharpCpp.Rbfx.ParseUmbrella.hpp')" Text="The engine binding metadata and the umbrella header were not staged for $(SharpCppRuntimeIdentifier)." />
    <Error Condition="'$(SharpCppAdditionalRuntimeIdentifier)' != '' and (!Exists('$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/metadata/SharpCpp.Rbfx.Bindings.json') or !Exists('$(SharpCppNuGetStageRoot)/runtime/$(SharpCppAdditionalRuntimeIdentifier)/metadata/SharpCpp.Rbfx.ParseUmbrella.hpp'))" Text="The engine binding metadata and the umbrella header were not staged for $(SharpCppAdditionalRuntimeIdentifier)." />
  </Target>
</Project>
